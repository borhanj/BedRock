seed.sql

# The live Cloudflare config. Copy wrangler.example.jsonc to wrangler.jsonc and
# fill in the D1 database id, the Access team domain and the AUD tag. None of
# them is a credential — Access puts the last two in the login redirect for
# anyone to see — but this repository is public and an account's infrastructure
# identifiers are nobody else's business.
wrangler.jsonc
